# Non-secret values only. Use with --env-file .env.production.
TASKFLOW_HOST=localhost
TASKFLOW_BIND_ADDRESS=127.0.0.1
TASKFLOW_HTTP_PORT=8080
TASKFLOW_HTTPS_PORT=8443
TASKFLOW_SECRET_DIRECTORY=./.runtime/secrets
TASKFLOW_TLS_DIRECTORY=./.runtime/tls
# Console delivery is for local verification only; configure real mail separately.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_EMAIL_TIMEOUT=5
